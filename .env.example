NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
TEMPERATURE=0.0
MAX_TOKENS=4096
LLM_TIMEOUT=120

# Per-agent model assignments (override default NVIDIA_MODEL)
AGENT_MODEL_BUSINESS_PROFILE=openai/gpt-oss-20b
AGENT_MODEL_MARKET_ANALYSIS=openai/gpt-oss-20b
AGENT_MODEL_COMPETITIVE_ANALYSIS=nvidia/nemotron-3-super-120b-a12b
AGENT_MODEL_SWOT=openai/gpt-oss-20b
AGENT_MODEL_MARKETING=openai/gpt-oss-20b
AGENT_MODEL_REPORT_WRITER=openai/gpt-oss-20b
AGENT_MODEL_MARKET_RESEARCH=openai/gpt-oss-20b

# Per-stage quality signal. The critic is one extra call per stage, on the
# deeper model, and a low score triggers one re-run of that stage.
ENABLE_STAGE_CRITIC=true
AGENT_MODEL_CRITIC=nvidia/nemotron-3-super-120b-a12b
CRITIC_RETRY_THRESHOLD=60
AGENT_MAX_ATTEMPTS=3

# Job runner. Keep concurrency at 1 on a small host: rendering is the memory
# ceiling and two concurrent renders push a small container over it.
JOB_CONCURRENCY=1
JOB_QUEUE_MAX=20
# A failed or interrupted job can be resumed from its first unfinished stage.
MAX_RETRIES_PER_JOB=2

# Finished jobs, their stage rows and report files are deleted after this many
# days without an update. 0 keeps everything; 30 is a sensible value.
RETENTION_DAYS=0
RETENTION_SWEEP_HOURS=6

# Database: set DATABASE_URL for PostgreSQL (Neon), leave empty for SQLite
DATABASE_URL=

# Upstash Redis for rate limiting (leave empty to use in-memory fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limiting. Applies to both submit endpoints and to resend/retry.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW=60
# Behind a reverse proxy every request looks like it comes from the proxy, so
# the proxy-set headers identify the caller. Only enable when a trusted proxy
# is the sole ingress (e.g. nginx, or a platform load balancer).
TRUST_PROXY_HEADERS=true

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Outbound fetch policy. The scraper fetches user-supplied URLs from inside the
# deployment network, so private ranges are refused by default. Disabling this
# on a host that runs other services is a server-side request forgery risk.
SCRAPER_BLOCK_PRIVATE_NETWORKS=true
SCRAPER_MAX_REDIRECTS=5

# Email.
#   smtp     - default; works with any mail vendor (some hosts block SMTP ports)
#   resend   - HTTP API
#   sendgrid - HTTP API (the trial this project used ended 2026-09-01)
#   console  - logs the message (local development)
#   file     - writes .eml to REPORT_OUTPUT_DIR/outbox (tests, CI)
# A selected-but-unconfigured provider fails at startup rather than silently
# redirecting mail somewhere else.
EMAIL_PROVIDER=smtp
FROM_EMAIL=reports@bisystem.com
EMAIL_MAX_ATTEMPTS=3
EMAIL_MAX_ATTACHMENT_MB=20

# Who reports may be sent to, and how often. The submitter names the recipient
# and nothing authenticates the submitter, so these keep the service from being
# used to mail strangers.
#   RECIPIENT_ALLOWLIST: addresses and/or domains, separated by commas or semicolons
#   ("me@example.com, @example.org"). Empty allows any recipient.
RECIPIENT_ALLOWLIST=
MAX_REPORTS_PER_RECIPIENT_PER_DAY=5
MAX_DELIVERIES_PER_JOB=3

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_TIMEOUT=30

RESEND_API_KEY=
SENDGRID_API_KEY=
REPORT_OUTPUT_DIR=reports
JOBS_DB=jobs.db
